# ==========================
# Server settings
# ==========================
PORT=5000
FRONTEND_URL=http://localhost:5173

# ==========================
# PostgreSQL database connection
# (Isi sesuai konfigurasi database lokal / server)
# ==========================
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seatudy

# ==========================
# JWT Secret
# (Gunakan string random panjang untuk keamanan)
# ==========================
JWT_SECRET=your_jwt_secret_key

# ==========================
# Session lifetime
# ==========================
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
NODE_ENV=development
# Kosongkan untuk mengikuti NODE_ENV, atau set false saat lokal via HTTP.
# COOKIE_SECURE=false
