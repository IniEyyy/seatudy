# Copy this file to .env before running docker compose:
#   copy .env.docker.example .env
#
# Use a long random value; never reuse this example in a shared environment.
JWT_SECRET=replace-with-a-long-random-secret

# Host port for the nginx frontend.
WEB_PORT=8080

# false for local HTTP. Set true when the app is served over HTTPS.
COOKIE_SECURE=false
